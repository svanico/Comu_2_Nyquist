function [o_channel] = channel(i_channel,i_cfg_s)

%%Settings
    en_ch = i_cfg_s.en_ch_filter;
    en_n = i_cfg_s.en_n;
    M = i_cfg_s.M;
    Lsymbs = i_cfg_s.Lsymbs;
    BR = i_cfg_s.BR;
    NTAPS = i_cfg_s.NTAPS_FIR;
    OVS = i_cfg_s.OVS;
    fs = OVS*BR;
    rolloff = i_cfg_s.rolloff;
    t0 = 0;
    delay = (NTAPS-1)/2;
    fc = i_cfg_s.ch_bw/(fs/2); %calculada para el FIR
    EbNo = i_cfg_s.Ebno;
    

%%Procesamiento
%Respuesta del canal

    if en_ch
        b = fir1(NTAPS,fc);  
    else
        b = 1;
    end

    if en_n
        n = AWGN_(M);
    else
        n = 0;
        

%Ruido

 


end

