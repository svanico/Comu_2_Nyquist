clear; clc; close all;

%% 1. Parámetros generales
cfg_s = struct();
cfg_s.BR              = 32e9;       % Baud rate 
cfg_s.M               = 16;         % Orden de modulacion
cfg_s.Lsymbs          = 1e6;        % Cantidad de simbolos
cfg_s.rolloff         = 0.6;        % Exceso de ancho de banda
cfg_s.EbNo            = 16;         % Valor de EbNo para los graficos temporales/debugging

% Sobremuestreo
cfg_s.OVS.CH          = 4;          % Sobremuestreo del transmisor/canal
cfg_s.OVS.DSP         = 2;          % Sobremuestreo del DSP/LMS
cfg_s.NTAPS_RRC       = 101;        % Filtros transmisor
cfg_s.en_carrier_recovery = 1;      % Habilita corrección en receptor

%% 2. Canal y ruido
cfg_s.en_ch_filter    = 1;          % Habilita filtro del canal
cfg_s.en_n            = 1;          % Habilita AWGN
cfg_s.pos_n           = 0;          % 1:ruido coloreado, 0:blanco
cfg_s.NTAPS_FIR       = 51;         % Coeficientes del canal
cfg_s.ch_bw           = 16e9;       % Ancho de banda del canal (leve)

%% 3. Errores de portadora
cfg_s.en_c_error      = 1;          % Habilita errores de portadora 
% Errores Estáticos 
cfg_s.delta_freq      = 0e6;        % Offset del LO
cfg_s.delta_freq_vec  = -cfg_s.BR/12 : cfg_s.BR/120 : cfg_s.BR/12;
cfg_s.phase_offset    = 0/180*pi;   % Error de fase
cfg_s.LW              = 0e3;        % Ancho de linea [Hz] -> Ruido de fase
% Fluctuaciones
cfg_s.freq_fluct_amp  = 0;
cfg_s.freq_fluct_freq = 0e3;
cfg_s.phase_tone_amp  = 0/180*pi;
cfg_s.phase_tone_freq = 0e6;

%% 4. Receptor (Ecualizador y Recuperador de Portadora)
% Parámetros del Ecualizador (FFE)
cfg_s.NTAPS_ffe       = 51;         % Cantidad de coeficientes del ecualizador
cfg_s.cma_step        = 0.2e-4;     % Paso de adaptación para convergencia ciega 
cfg_s.dd_step         = 1e-4;       % Paso de adaptación para seguimiento fino
cfg_s.leak            = 1e-7;       % Factor de pérdida (leakage)

% Parámetros del PLL y RFD
cfg_s.Kp              = 1e-3;       % Ganancia proporcional del PLL
cfg_s.Ki              = cfg_s.Kp/1000; % Ganancia integral del PLL
cfg_s.rfd_gain        = 1e-4;       % Ganancia del detector de frecuencia

% Timers (FSM RX)
cfg_s.t1_rfd_frac    = 0.2;
cfg_s.t2_fcr_v4_frac = 0.3;
cfg_s.t3_fcr_dd_frac = 0.4;
cfg_s.t4_ffe_dd_frac = 0.6;
cfg_s.t1_rfd    = fix(cfg_s.t1_rfd_frac * cfg_s.Lsymbs);    
cfg_s.t2_fcr_v4 = fix(cfg_s.t2_fcr_v4_frac * cfg_s.Lsymbs); 
cfg_s.t3_fcr_dd = fix(cfg_s.t3_fcr_dd_frac * cfg_s.Lsymbs); 
cfg_s.t4_ffe_dd = fix(cfg_s.t4_ffe_dd_frac * cfg_s.Lsymbs); 

%% 5. CONFIGURACIÓN DE SIMULACIONES Y DEBUGGING
cfg_s.en_curva_ber    = 0;          
cfg_s.en_plots_tx     = 0; 
cfg_s.en_plots_rx     = 1;            
cfg_s.debug_psd       = 0;            
cfg_s.debug_eye       = 0;            
cfg_s.debug_const     = 1;            
cfg_s.debug_Nsymbs    = cfg_s.Lsymbs; 


%% ========================================================================
%% EJECUCIÓN BARRIDO DE FRECUENCIA
%% ========================================================================

% 1. Pre-paramos la figura de recuperación y la paleta de colores ANTES del loop
if cfg_s.en_carrier_recovery
    figure('Name', '4. Recuperación de Portadora (PLL) - Barrido', ...
           'Color', 'w', 'Position', [150, 250, 1400, 750]);
    % Generamos colores distintos para cada iteración
    colores = lines(length(cfg_s.delta_freq_vec)); 
end

% Asumo FRAME_LOG = 1, si tu simulador usa otro valor cambialo acá.
FRAME_LOG = 1; 

for i=1:(length(cfg_s.delta_freq_vec)) 
    fprintf('\nSimulacion: M = %d | EbNo = %.1f dB | Lsymbs = %d | freq_offset = %.1e Hz\n', ...
            cfg_s.M, cfg_s.EbNo, cfg_s.Lsymbs, cfg_s.delta_freq_vec(i));
    
    % 1. Transmisor
    o_tx_s  = transmisor_QAM(cfg_s);
    
    % 2. Canal
    cfg_s.delta_freq = cfg_s.delta_freq_vec(i);
    o_canal = channel(o_tx_s.o_tx, cfg_s);
    
    % 3. Receptor
    o_rx    = Receiver(o_canal, cfg_s, o_tx_s.ak); 
    
    % 4. Verificador de BER
    [ber, errors]  = BER_checker(o_rx.ak_hat_fixed, o_rx.ak_tx_aligned, cfg_s.M, 0);
    
    fprintf('MSE: %.2f dB | BER: %.4e | Errores: %d\n', o_rx.MSE, ber, errors);
    
    % --- PLOTEO SUPERPUESTO (Adentro del Loop dibujamos las líneas) ---
    if cfg_s.en_carrier_recovery
        symb_axis = (1:length(o_rx.phase_integral_log)) .* FRAME_LOG;
        
        % Subplot 1: Trayectoria Fase
        subplot(2,3,1); hold on;
        fase_envuelta = wrapToPi(o_rx.phase_acc_log);
        plot(symb_axis, fase_envuelta, 'LineWidth', 1, 'Color', colores(i,:));
        
        % Subplot 2: Seguimiento Frecuencia
        subplot(2,3,2); hold on;
        freq_est_MHz = o_rx.phase_integral_log .* cfg_s.BR ./ (2*pi) ./ 1e6;
        plot(symb_axis, freq_est_MHz, 'LineWidth', 1.5, 'Color', colores(i,:), ...
             'DisplayName', sprintf('%.1f MHz', cfg_s.delta_freq_vec(i)/1e6));

        
        % Preparación de datos para constelación
        N_tail = min(2000, length(o_rx.slicer_in_log));
        slicer_in = o_rx.slicer_in_log;
        phase_acc = o_rx.phase_acc_log;
        ffe_out = slicer_in .* exp(1j * phase_acc);
        
        % Subplot 4: Constelación ANTES
        subplot(2,3,4); hold on;
        scatter(real(ffe_out(end-N_tail:end)), imag(ffe_out(end-N_tail:end)), ...
                5, colores(i,:), 'filled', 'MarkerFaceAlpha', 0.5);
                
        % Subplot 5: Constelación DESPUÉS
        subplot(2,3,5); hold on;
        scatter(real(slicer_in(end-N_tail:end)), imag(slicer_in(end-N_tail:end)), ...
                5, colores(i,:), 'filled', 'MarkerFaceAlpha', 0.5);
    end 
end

%% ========================================================================
%% FORMATO ESTÉTICO POST-BARRIDO (Se ejecuta una sola vez)
%% ========================================================================
if cfg_s.en_carrier_recovery
    
    % --- Formato Subplot 1 ---
    subplot(2,3,1);
    grid on;
    xline(cfg_s.t2_fcr_v4, 'k--', 'FCR ON', 'LabelVerticalAlignment', 'bottom', 'LineWidth', 1.5);
    ylim([-pi, pi]);
    yticks([-pi, -pi/2, 0, pi/2, pi]);
    yticklabels({'-\pi', '-\pi/2', '0', '\pi/2', '\pi'});
    xlabel('Símbolos', 'FontWeight', 'bold'); 
    ylabel('Ángulo de Corrección [rad]', 'FontWeight', 'bold');
    title('Trayectoria de Fase (NCO)');
    
    % --- Formato Subplot 2 ---
    subplot(2,3,2);
    grid on;
    xline(cfg_s.t2_fcr_v4, 'k--', 'FCR ON', 'LabelVerticalAlignment', 'bottom', 'LineWidth', 1.5);
    xlabel('Símbolos', 'FontWeight', 'bold'); 
    ylabel('Offset Estimado [MHz]', 'FontWeight', 'bold');
    title('Seguimiento de Frecuencia (Convergencia Integral)');
    
    % --- Subplot 3: Bode del DPLL (Solo hace falta calcularlo una vez) ---
    subplot(2,3,3);
    Kp = cfg_s.Kp; 
    Ki = cfg_s.Ki; 
    BR = cfg_s.BR;
    n_freq_pos = 2^16;
    n_freq_frac = 2^16;
    n_v = [0, logspace(-log10(n_freq_frac), log10(n_freq_pos), n_freq_pos+n_freq_frac-1)];
    f_v = n_v * BR / 2 / n_freq_pos;
    wd_v = n_v * pi / n_freq_pos;
    
    G_th_v = (Kp + Ki .* 1./(1 - exp(-1j.*wd_v))) .* 1./(1 - exp(-1j.*wd_v));
    H_th_v = G_th_v ./ (1 + G_th_v);
    H_th_db_v = 20*log10(abs(H_th_v));
    
    semilogx(f_v, H_th_db_v, '-', 'Linewidth', 1.5, 'Color', '#0072BD');
    hold on;
    plot(xlim, [-3 -3], '-.m', 'Linewidth', 1, 'DisplayName', '-3 dB');
    grid on; xlim([1e6, 1e9]);
    xlabel('Frecuencia [Hz]', 'FontWeight', 'bold');
    ylabel('Amplitud [dB]', 'FontWeight', 'bold');
    title(sprintf('Jitter Transfer (BR=%.2f GBd)', BR/1e9));
    leg_str = sprintf('Kp = %.2e\nKi = %.2e', Kp, Ki);
    legend(leg_str, '-3 dB', 'Location', 'southwest', 'FontSize', 8);

    % --- Formato Subplot 4 ---
    subplot(2,3,4);
    grid on; axis square;
    xlabel('In-Phase (I)', 'FontWeight', 'bold');
    ylabel('Quadrature (Q)', 'FontWeight', 'bold');
    title('ANTES del FCR (Salida FFE)');
    
    % --- Formato Subplot 5 ---
    subplot(2,3,5);
    grid on; axis square;
    xlabel('In-Phase (I)', 'FontWeight', 'bold');
    ylabel('Quadrature (Q)', 'FontWeight', 'bold');
    title('DESPUÉS del FCR (Entrada Slicer)');
end